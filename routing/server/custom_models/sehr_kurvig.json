    { "if": "road_class == RESIDENTIAL", "multiply_by": "0.4" },
    { "if": "curvature > 0.95", "multiply_by": "0.15" },
    { "else_if": "curvature > 0.85", "multiply_by": "0.4" },
    { "else_if": "curvature > 0.75", "multiply_by": "0.8" }
  ]
