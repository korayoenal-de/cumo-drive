{
  "distance_influence": 15,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "road_class == TRACK || road_class == LIVING_STREET || road_class == PEDESTRIAN", "multiply_by": "0" },
    { "if": "road_class == SERVICE", "multiply_by": "0.1" },
    { "if": "track_type != MISSING && track_type != GRADE1", "multiply_by": "0" },
    { "if": "surface == UNPAVED || surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL || surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND", "multiply_by": "0" },
    { "if": "surface == COBBLESTONE || surface == PAVING_STONES", "multiply_by": "0.3" },
    { "if": "max_width < 2.5", "multiply_by": "0.05" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0.15" },
    { "if": "road_environment == FERRY", "multiply_by": "0.3" },
    { "if": "curvature > 0.97", "multiply_by": "0.45" },
    { "else_if": "curvature > 0.9", "multiply_by": "0.7" },
    { "else_if": "curvature > 0.8", "multiply_by": "0.9" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" },
    { "if": "road_class == RESIDENTIAL || road_class == UNCLASSIFIED", "limit_to": "40" }
  ]
}
