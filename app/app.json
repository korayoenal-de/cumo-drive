{
  "expo": {
    "name": "CUMO DRIVE",
    "slug": "cumo-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cumodrive",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "de.rallycumo.drive",
      "appleTeamId": "N9DX399W33",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "de.rallycumo.drive"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CUMO DRIVE nutzt deinen Standort für die Navigation und als Start für Rundtouren.",
          "locationAlwaysAndWhenInUsePermission": "CUMO DRIVE nutzt deinen Standort auch bei gesperrtem Bildschirm, damit Routenführung und Gruppenfahrt weiterlaufen.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CUMO DRIVE nutzt die Kamera, um Touren aus dem Web Planer per QR Code zu übernehmen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.de.rallycumo.drive",
          "frequentUpdates": true,
          "enablePushNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0C",
    "owner": "korayoenals-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "44e0d073-6f59-455d-8a50-0f11f6fef4b7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/44e0d073-6f59-455d-8a50-0f11f6fef4b7"
    }
  }
}
