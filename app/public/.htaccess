# CUMO DRIVE Web (cumodrive.de): Startseite ist die Landingpage, der Planer liegt unter /planer
DirectoryIndex index.html
Options -MultiViews
RewriteEngine On

# eine Adresse: alles (http, www, cumodrive.com, drive.rallycumo.de) dauerhaft auf https://cumodrive.de, Pfad bleibt.
# Alte Links wie drive.rallycumo.de/t#... funktionieren weiter, der Browser behält den Teil nach # beim Weiterleiten.
RewriteCond %{HTTP_HOST} !^cumodrive\.de$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://cumodrive.de%{REQUEST_URI} [L,R=301]

# saubere Adressen: /login liefert login.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /+not-found.html

<IfModule mod_headers.c>
  # Konto und Planer gehören nicht in die Suche
  SetEnvIf Request_URI "^/(planer|login|registrieren|profil|menu|garage|nachrichten|scan|karte|navigation|anpassen|ansagen|blockiert|mitgliedschaft|pruefung|fahrt|gruppe|ausfahrt|a|t)(\.html|/|$)" CD_NOINDEX
  Header set X-Robots-Tag "noindex" env=CD_NOINDEX

  # Seiten immer frisch laden, damit ein neuer Upload sofort gilt; die Skripte haben Hashes im Namen und dürfen lange im Cache bleiben
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
